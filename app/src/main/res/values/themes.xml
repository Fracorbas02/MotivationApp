<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MotivationApp" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color -->
        <item name="colorPrimary">@color/purple_800</item>
        <item name="colorPrimaryContainer">@color/purple_900</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorOnPrimaryContainer">@color/white</item>

        <!-- Secondary brand color -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryContainer">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="colorOnSecondaryContainer">@color/white</item>

        <!-- Surface colors -->
        <item name="colorSurface">@color/white</item>
        <item name="colorSurfaceVariant">@color/gray_light</item>
        <item name="colorOnSurface">@color/black</item>
        <item name="colorOnSurfaceVariant">@color/gray_dark</item>

        <!-- Error colors -->
        <item name="colorError">@color/red_500</item>
        <item name="colorErrorContainer">@color/red_700</item>
        <item name="colorOnError">@color/white</item>
        <item name="colorOnErrorContainer">@color/white</item>

        <!-- Other colors -->
        <item name="android:colorBackground">@color/gray_background</item>
        <item name="colorOutline">@color/gray</item>

        <!-- Typography -->
        <item name="android:fontFamily">@font/roboto</item>
    </style>
</resources>
